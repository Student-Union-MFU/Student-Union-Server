# Copy to .env on each machine and fill in. .env is gitignored — never commit it.
#   cp .env.example .env

# "production" makes the OAuth state cookie Secure (HTTPS-only). Safe to set
# once traffic comes through the Cloudflare tunnel, since that is real HTTPS.
# Keep "development" for plain-HTTP local work or the login flow breaks.
ENV=development
SERVER_HOST=localhost
SERVER_PORT=8080
BASE_URL_DEVELOPMENT=http://localhost:8080

JWT_SECRET=
JWT_EXPIRY=24h

# The redirect URL must match what is registered in Google Cloud Console
# exactly. Through the tunnel that is https://<your-hostname>/su-server/auth/google/callback
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URL=

DB_USER=admin
DB_PASS=
DB_NAME=sudb
# compose overrides this to "database"; localhost is for `make dev` on the host
DB_HOST=localhost
DB_PORT=5432

# Extra browser origins allowed to call this API, comma-separated. ADDED to the
# built-in defaults (localhost:3000, localhost:3001, *.trycloudflare.com), so
# only list what those miss — typically web-next's address when it runs on
# another machine on the LAN.
# CORS_ALLOWED_ORIGINS=http://172.26.55.36:3000,http://192.168.1.50:3000

# From the Cloudflare dashboard: Zero Trust > Networks > Tunnels > your tunnel >
# Configure. It is the long string in the shown `cloudflared ... run <TOKEN>`
# command. Treat it as a secret — it grants access to route traffic to you.
TUNNEL_TOKEN=

# path ของ service account Firebase **ในมุมมองของ container** ไม่ใช่ path บนเครื่อง
# ไม่ตั้ง = push ปิดเงียบ แชทกับทุกอย่างอื่นยังทำงานปกติ
# วางไฟล์จริงไว้ที่ ./secrets/ บนเครื่อง แล้ว compose mount ให้เป็น /run/secrets
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-adminsdk.json

# ---------- WBW (เดินรอบดอย) ----------

# เบอร์กลางงาน — ปุ่มโทรสำรองในแอปตอน SOS ส่งไม่ออก · ว่าง = แอปใช้ค่าที่ฝังมาใน Config.swift
WBW_EMERGENCY_PHONE=

# ---------- Club Fair ----------

# Club Fair signs its own tokens with its own key — see ClubFairTokenService.
# Leave unset and the /clubfair routes are simply not registered.
CLUBFAIR_JWT_SECRET=
CLUBFAIR_CHECKIN_MAX_AGE_SECONDS=180
# App Review only. One booth whose codes may arrive at any age, so the QR image
# attached to an App Store submission still verifies days after it was minted —
# a code that rotates every 30 seconds cannot be posted to a reviewer. The HMAC
# is still checked, so the only payload this admits is the one in that image.
# BOTH must be set or there is no exemption, and it lapses on its own at the
# date below: set that before the fair opens and the ordinary three-minute rule
# is back without anyone having to remember to unset anything.
CLUBFAIR_REVIEW_BOOTH_ID=
CLUBFAIR_REVIEW_CODE_UNTIL=
# Which intakes may open a NEW account, as the leading digits of a student id:
# "69" is the 2569 entry, so 67-69 is the three years currently on campus.
# Comma-separated, "*" to accept any. Accounts that already exist sign in
# whatever their year, so this never locks anyone out retrospectively.
CLUBFAIR_INTAKE_PREFIXES=67,68,69
# Extra accepted Google OAuth audiences (comma-separated), for the Android and
# iOS clients when they use their own client ids rather than the web one.
GOOGLE_ALLOWED_AUDIENCES=
